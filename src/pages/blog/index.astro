---

<Layout
  title="the essay archive · du xiang"
  description="Every essay on du-xiang.com, grouped by year. Long-form writing on LLM systems, MLOps, and production machine learning."
>
  <div id="single">
    <h2>the essay archive</h2>
    <p>
      Everything, grouped by year. The dates run a little ahead of the calendar in
      places; the archive does not judge, and neither should you. Subscribe to the
      <a href="/rss.xml">feed</a> and never check this page again.
    </p>

    {years.map((y) => (
      <div>
        <h3 class="archive-year">{y.year}</h3>
        <ul class="archive-list">
          {y.items.map((e) => (
            <li>
              <span class="date">{e.date}</span>
              <a
                href={e.link}
                target={e.external ? '_blank' : undefined}
                rel={e.external ? 'noopener noreferrer' : undefined}
              >{e.title}</a>
              <span class="meta"> &middot; {e.filed} &middot; {e.time}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="meta" style="margin-top: 1.5em;">
      nine essays in four years. quality over quantity, or so i tell my feed reader.
    </p>
  </div>
</Layout>
