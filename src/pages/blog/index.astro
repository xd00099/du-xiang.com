      },
      {
        date: 'feb 9',
        title: 'Agent Teams vs Sub-Agents: Multi-Agent Architectures for LLMs',
        link: '/blog/agent-teams-architecture',
        filed: 'ai agents, architecture',
        time: '18 min',
      },
      {
