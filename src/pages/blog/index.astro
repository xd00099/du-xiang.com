        link: '/blog/skills-vs-mcp-agents',
        filed: 'mcp, ai agents',
        time: '14 min',
      },
    ],
  },
  {
    year: '2025',
    items: [
      {
        date: 'aug 7',
        title: 'Context Engineering: Building Intelligent Memory Systems',
        link: '/blog/context-engineering-memory',
        filed: 'memory, ai agents',
        time: '16 min',
      },
    ],
  },
  {
    year: '2024',
    items: [
      {
        date: 'sep 20',
        title: 'Scaling SEO & GEO Content with LLMs',
        link: '/blog/seo-geo-content-generation',
        filed: 'seo, content',
        time: '15 min',
      },
      {
        date: 'jun 10',
        title: 'Real-Time Personalized Quick Suggest with WebSockets',
        link: '/blog/realtime-quick-suggest',
        filed: 'faiss, websockets',
        time: '15 min',
      },
      {
        date: 'mar 15',
        title: 'Hot-Swappable LoRA: Serving 16 Models on One GPU',
        link: '/blog/multi-lora-serving',
        filed: 'mlops, vllm',
        time: '15 min',
      },
    ],
  },
  {
    year: '2023',
    items: [
      {
        date: 'dec 28',
        title: 'Latent Reasoning: Teaching Small LLMs to Think Without Thinking',
        link: '/blog/latent-reasoning-slm',
        filed: 'fine-tuning, ml systems',
        time: '12 min',
      },
    ],
  },
  {
    year: 'elsewhere',
    items: [
      {
        date: '2021',
        title: 'Lipstick Recommendation',
        link: 'https://mp.weixin.qq.com/s/RryxBWAClB9AgIqFvoSbhg',
        filed: 'data science · off-site, in chinese',
        time: '8 min',
        external: true,
      },
      {
        date: '2020',
        title: 'Earthquake Analysis',
        link: 'https://mp.weixin.qq.com/s/Od3sdJ60wn4WKgM2PfC05A',
        filed: 'visualization · off-site, in chinese',
