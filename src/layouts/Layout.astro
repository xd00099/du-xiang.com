---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'du xiang · machine learning, production systems, and other small obsessions',
  description = 'The weblog of Du Xiang, a machine learning engineer in the Bay Area. Long essays on LLM systems, hand-coded markup, and an RSS feed. Standards-compliant in spirit since 2003.',
} = Astro.props;
---

<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <!-- No viewport meta. This layout is 760 pixels wide, as nature intended. -->
    <meta name="description" content={description} />
    <meta name="author" content="Du Xiang" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://du-xiang.com" />

    <link rel="icon" type="image/jpeg" href="/images/title.jpg" />
    <link rel="alternate" type="application/rss+xml" title="du xiang (RSS 2.0)" href="/rss.xml" />

    <title>{title}</title>
  </head>

  <body>
    <!-- hand-coded. view source all you like; that's what it's for. -->
    <div id="page">
      <div id="masthead">
        <h1><a href="/" title="back to the front page">du xiang</a></h1>
        <p id="tagline">machine learning, production systems, and other small obsessions</p>
        <p id="nav">
          <a href="/">home</a>
          <a href="/blog">essays</a>
          <a href="/links">blogroll</a>
          <a href="/colophon">colophon</a>
          <a href="/rss.xml" title="subscribe to the feed"><img src="/standards/feed.gif" width="14" height="14" alt="RSS" /> subscribe</a>
        </p>
      </div>

      <slot />

      <div id="footer">
        &copy; 2003&ndash;2026 du xiang &middot; <a href="https://creativecommons.org/licenses/by-sa/4.0/">some rights reserved</a> &middot;
        <a href="/rss.xml">rss 2.0</a> &middot;
        <a href="/colophon">xhtml 1.0 strict (in spirit)</a>
        <p class="fineprint">
          hand-coded in textmate, give or take. no tables were used in this layout
          &mdash; we deleted them all in june, and it was emotional.
        </p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
